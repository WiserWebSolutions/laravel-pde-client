parameters:
    level: 5
    excludePaths:
        analyseAndScan:
            - src/Ai
            - src/Mcp
            - src/Integrations
    paths:
        - src
    tmpDir: .phpstan-cache
services:
    -
        class: WiserWebSolutions\PDEClient\Tests\PHPStan\AvailabilityPropertiesExtension
        tags:
            - phpstan.properties.readWriteExtension
