{
    "name": "wiserwebsolutions/pde-integration-tests",
    "repositories": [
        {
            "type": "path",
            "url": "../..",
            "options": {
                "symlink": true
            }
        }
    ],
    "require": {
        "wiserwebsolutions/laravel-pde-client": "@dev",
        "laravel/ai": "^1.2",
        "laravel/mcp": "^1.0",
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^12.0",
        "phpstan/phpstan": "^2.1",
        "laravel/pint": "^1.30"
    },
    "autoload-dev": {
        "psr-4": {
            "WiserWebSolutions\\PDEClient\\Tests\\": "../../tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": false
    },
    "type": "project"
}
