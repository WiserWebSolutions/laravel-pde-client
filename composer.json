{
    "name": "wiserwebsolutions/laravel-pde-client",
    "description": "Fluent Laravel client for Pennsylvania Department of Education financial, enrollment, assessment, graduation, and staffing data.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "pennsylvania",
        "pde",
        "school-finance",
        "gfb",
        "afr"
    ],
    "require": {
        "php": "^8.2",
        "ext-dom": "*",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/filesystem": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/contracts": "^10.0|^11.0|^12.0|^13.0",
        "openspout/openspout": "^4.24",
        "phpoffice/phpspreadsheet": "^5.9",
        "spatie/laravel-data": "^4.23",
        "guzzlehttp/psr7": "^2.6",
        "guzzlehttp/guzzle": "^7.5"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.5|^11.0|^12.0",
        "laravel/pint": "^1.30.4",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "WiserWebSolutions\\PDEClient\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WiserWebSolutions\\PDEClient\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "WiserWebSolutions\\PDEClient\\PDEClientServiceProvider"
            ],
            "aliases": {
                "PDE": "WiserWebSolutions\\PDEClient\\Facades\\PDE"
            }
        }
    },
    "scripts": {
        "test": "phpunit",
        "format": "pint --max-processes=1",
        "format:check": "pint --test --max-processes=1",
        "analyse": "phpstan analyse --memory-limit=1G",
        "check": [
            "@format:check",
            "@analyse",
            "@test"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "suggest": {
        "laravel/ai": "Optional Laravel AI tools and reference analyst (^1.2; PHP 8.3+, Laravel 12–13).",
        "laravel/mcp": "Optional local PDE MCP server (^1.0)."
    }
}
